"use client";

import { useState } from "react";
import { useRouter } from "next/navigation";
import Link from "next/link";
import { getLastPlayerName, setLastPlayerName } from "@/lib/client-name";

type View = "choose" | "join";

export default function QuizLandingPage() {
  const router = useRouter();
  const [view, setView] = useState<View>("choose");
  const [pin, setPin] = useState("");
  const [nameInput, setNameInput] = useState(() =>
    typeof window !== "undefined" ? getLastPlayerName() : ""
  );
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  async function hostGame() {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch("/api/quiz/host/new", { method: "POST" });
      const data = await res.json();
      if (!res.ok) {
        setError(data.error ?? "Could not create game.");
        return;
      }
      router.push(`/games/quiz/host/${data.gameId}`);
    } finally {
      setLoading(false);
    }
  }

  async function joinGame() {
    const trimmedPin = pin.trim();
    const trimmedName = nameInput.trim();
    if (!trimmedPin) {
      setError("Enter the game PIN.");
      return;
    }
    if (!trimmedName) {
      setError("Enter a name first.");
      return;
    }
    setLoading(true);
    setError(null);
    try {
      const res = await fetch("/api/quiz/player/join", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ pin: trimmedPin, playerName: trimmedName }),
      });
      const data = await res.json();
      if (!res.ok) {
        setError(data.error ?? "Could not join game.");
        return;
      }
      setLastPlayerName(trimmedName);
      router.push(
        `/games/quiz/play/${data.gameId}?playerKey=${encodeURIComponent(data.playerKey)}&name=${encodeURIComponent(data.displayName)}`
      );
    } finally {
      setLoading(false);
    }
  }

  return (
    <div className="mx-auto flex w-full max-w-md flex-1 flex-col items-center px-4 py-8">
      <div className="mb-6 flex w-full items-center justify-between">
        <div>
          <h1 className="font-mono text-2xl font-bold tracking-tight">AWS TRIVIA LIVE</h1>
          <p className="text-xs text-text-muted">Host on a shared screen, everyone else joins on their phone.</p>
        </div>
        <Link
          href="/games/quiz/leaderboard"
          className="rounded-md border border-border px-3 py-1.5 font-mono text-xs text-text-muted transition hover:border-purple hover:text-purple"
        >
          Leaderboard
        </Link>
      </div>

      {view === "choose" && (
        <div className="flex w-full flex-col gap-3 rounded-xl border border-border bg-surface p-6">
          <button
            onClick={hostGame}
            disabled={loading}
            className="rounded-md bg-purple px-4 py-3 text-center font-mono font-semibold text-white transition hover:bg-purple-dark disabled:opacity-50"
          >
            {loading ? "Creating..." : "Host a Game"}
          </button>
          <button
            onClick={() => {
              setError(null);
              setView("join");
            }}
            className="rounded-md border-2 border-border px-4 py-3 text-center font-mono font-semibold transition hover:border-purple"
          >
            Join a Game
          </button>
          {error && <p className="text-center text-sm text-orange">{error}</p>}
        </div>
      )}

      {view === "join" && (
        <div className="flex w-full flex-col items-center gap-4 rounded-xl border border-border bg-surface p-6">
          <input
            autoFocus
            value={pin}
            onChange={(e) => setPin(e.target.value.replace(/\D/g, "").slice(0, 6))}
            maxLength={6}
            inputMode="numeric"
            placeholder="Game PIN"
            className="w-full rounded-md border border-border bg-surface-2 px-3 py-3 text-center font-mono text-2xl tracking-widest text-text outline-none focus:border-purple"
          />
          <input
            value={nameInput}
            onChange={(e) => setNameInput(e.target.value)}
            onKeyDown={(e) => e.key === "Enter" && joinGame()}
            maxLength={30}
            placeholder="Your name"
            className="w-full rounded-md border border-border bg-surface-2 px-3 py-2 text-center font-mono text-text outline-none focus:border-purple"
          />
          {error && <p className="text-center text-sm text-orange">{error}</p>}
          <div className="flex w-full gap-2">
            <button
              onClick={() => setView("choose")}
              className="rounded-md border border-border px-4 py-2 font-mono text-text-muted transition hover:border-purple hover:text-purple"
            >
              Back
            </button>
            <button
              onClick={joinGame}
              disabled={loading}
              className="flex-1 rounded-md bg-purple px-4 py-2 font-mono font-semibold text-white transition hover:bg-purple-dark disabled:opacity-50"
            >
              {loading ? "Joining..." : "Join"}
            </button>
          </div>
        </div>
      )}
    </div>
  );
}
